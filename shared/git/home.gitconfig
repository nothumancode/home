[alias]
	dft = difftool
[branch]
	sort = -committerdate
[commit]
	verbose = true
[core]
	autocrlf = input
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true
	tool = difftastic
[difftool "difftastic"]
	cmd = difft \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[fetch]
	prune = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[pager]
	difftool = true
[push]
	autoSetupRemote = true
	default = simple
[rebase]
	autoSquash = true
	autoStash = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	sort = version:refname
[user]
	email = rodat.dev@proton.me
	name = Tomas Roda
	useConfigOnly = true
