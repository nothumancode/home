[include]
	path = {{ (mise_config_dir ~ "/../shared/git/home.gitconfig") | canonicalize | json_encode() }}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper =
	helper = {{ ("!" ~ (mise_bin | quote) ~ ' -C "$HOME" exec -- gh auth git-credential') | json_encode() }}
[credential "https://gist.github.com"]
	helper =
	helper = {{ ("!" ~ (mise_bin | quote) ~ ' -C "$HOME" exec -- gh auth git-credential') | json_encode() }}
[include]
	path = {{ (xdg_config_home ~ "/git/enterprise.gitconfig") | json_encode() }}
